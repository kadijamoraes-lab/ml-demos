# Criando dataset com novo item "Bread" (Pão) para explorar possibilidades
# Adicionamos mais uma coluna para verificar como o algoritmo reage a um item novo
columns = ['ID', 'Beer', 'Diaper', 'Gum', 'Soda', 'Snack', 'Bread']
dataset = [
    [1, 1, 1, 1, 1, 0, 1],
    [2, 1, 1, 0, 0, 0, 0],
    [3, 1, 1, 1, 0, 1, 1],
    [4, 1, 1, 0, 1, 1, 0],
    [5, 0, 1, 0, 1, 0, 1],
    [6, 0, 1, 0, 0, 0, 1],
    [7, 0, 1, 0, 0, 0, 0],
    [8, 0, 0, 0, 1, 1, 1],
    [9, 0, 0, 0, 1, 1, 0]

df = pd.DataFrame(dataset, columns=columns)

class Apriori:
    threshold = 0.5
    df = None

    def __init__(self, df, threshold=None, transform_bol=False):
        self._validate_df(df)
        self.df = df
        if threshold is not None:
            self.threshold = threshold
        if transform_bol:
            self._transform_bol()

    def _validate_df(self, df=None):
        if df is None:
            raise Exception("df deve ser um pandas.DataFrame válido.")

    def _transform_bol(self):
        # Transformando valores 1/0 para True/False
        for column in self.df.columns:
            self.df[column] = self.df[column].apply(lambda x: True if x == 1 else False)

    def _apriori(self, use_colnames=False, max_len=None, count=True):
        apriori_df = apriori(
            self.df,
            min_support=self.threshold,
            use_colnames=use_colnames,
            max_len=max_len
        )
        if count:
            apriori_df['length'] = apriori_df['itemsets'].apply(lambda x: len(x))
        return apriori_df

    def run(self, use_colnames=False, max_len=None, count=True):
        return self._apriori(use_colnames=use_colnames, max_len=max_len, count=count)

    def filter(self, apriori_df, length, threshold):
        if 'length' not in apriori_df.columns:
            raise Exception("Execute com count=True para usar o filtro por tamanho.")
        return apriori_df[
            (apriori_df['length'] == length) & (apriori_df['support'] >= threshold)
        ]

# Removendo coluna ID antes de aplicar o Apriori (não relevante)
if 'ID' in df.columns: del df['ID']

# Alteramos o threshold de 0.4 para 0.3 para explorar mais combinações
apriori_runner = Apriori(df, threshold=0.3, transform_bol=True)
apriori_df = apriori_runner.run(use_colnames=True)

print("Resultados completos do Apriori:")
print(apriori_df)

# Novo filtro: pares com suporte maior que 0.35
print("\nFiltrando pares com suporte > 0.35:")
print(apriori_runner.filter(apriori_df, length=2, threshold=0.35))

